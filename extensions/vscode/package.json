{
  "name": "gemmaforge-vscode",
  "displayName": "GemmaForge",
  "description": "Real-time vulnerability-warning overlay backed by the GemmaForge streaming probe.",
  "version": "0.0.1",
  "publisher": "peaktwilight",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:gemmaforge.probeSelection"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gemmaforge.probeSelection",
        "title": "GemmaForge: Probe current selection"
      }
    ],
    "configuration": {
      "title": "GemmaForge",
      "properties": {
        "gemmaforge.serverUrl": {
          "type": "string",
          "default": "http://localhost:8787",
          "description": "Base URL of the GemmaForge streaming probe server."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.6.0"
  }
}
